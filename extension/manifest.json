{
  "manifest_version": 3,
  "name": "Waddle",
  "description": "Lets Waddle, your desktop duck, read and use web pages in Chrome when you ask it to.",
  "version": "0.1.13",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "tabs", "scripting", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "build/background.js", "type": "module" },
  "icons": { "128": "icon128.png" }
}
