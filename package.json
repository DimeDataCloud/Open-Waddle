{
  "name": "waddle",
  "private": true,
  "license": "MIT",
  "version": "0.2.9",
  "description": "Project Waddle: an embodied desktop AI agent that walks to what it acts on.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build && npm run build:extension",
    "pack:extension": "node scripts/pack-extension.mjs",
    "build:extension": "tsc -p extension/tsconfig.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p extension/tsconfig.json",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.20.5",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
